# ===== MoMA 接入配置模板 =====
# 用法：复制本文件为 .env，再填入真实密钥
#   Windows     : Copy-Item .env.example .env
#   macOS/Linux : cp .env.example .env
#
# 安全提醒：.env 已在 .gitignore 中，切勿把真实密钥提交进仓库，
#          也不要把密钥写进代码、文档或聊天记录。

# ---- 主 Agent：主流程推理（咨询等）----
MOMA_MAIN_API_BASE=https://zhenze-huhehaote.cmecloud.cn/v1
MOMA_MAIN_API_KEY=your-main-api-key-here
MOMA_MAIN_MODEL=deepseek-v4-flash-0731

# ---- 子 Agent：部门事项子 Agent ----
# 注意：模型名不要带 zhipu/ 前缀（带前缀会 404）
MOMA_SUB_API_BASE=https://zhenze-huhehaote.cmecloud.cn/v1
MOMA_SUB_API_KEY=your-sub-api-key-here
MOMA_SUB_MODEL=glm-5.2

# ---- 可选参数 ----
# MOMA_TIMEOUT=30        # 超时秒数，默认 30
# MOMA_MAX_RETRIES=2     # 5xx / 429 的失败重试次数，默认 2
# MOMA_DISABLE_LIVE=1    # 设为 1 时忽略环境变量、强制桩模式（离线 / 测试用）
# MOMA_API_BASE=         # 兼容旧变量：主角色的回退地址
# MOMA_API_KEY=          # 兼容旧变量：主角色的回退密钥
